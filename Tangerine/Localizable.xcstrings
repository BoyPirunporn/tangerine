{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "Waiting": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รอคิว"
          }
        }
      }
    },
    "Cancelled": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยกเลิกแล้ว"
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยกเลิก"
          }
        }
      }
    },
    "Show in Finder": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แสดงใน Finder"
          }
        }
      }
    },
    "Convert to": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แปลงเป็น"
          }
        }
      }
    },
    "Quality": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณภาพ"
          }
        }
      }
    },
    "Where converted files are saved": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ที่บันทึกไฟล์ที่แปลงแล้ว"
          }
        }
      }
    },
    "Use original folder": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้โฟลเดอร์เดิมของไฟล์"
          }
        }
      }
    },
    "Next to original": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้างไฟล์ต้นฉบับ"
          }
        }
      }
    },
    "Choose": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือก"
          }
        }
      }
    },
    "Add Files…": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่มไฟล์…"
          }
        }
      }
    },
    "PDF Tools": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เครื่องมือ PDF"
          }
        }
      }
    },
    "Merge into One PDF…": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รวมเป็น PDF ไฟล์เดียว…"
          }
        }
      }
    },
    "Split PDF into Pages…": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แยก PDF เป็นรายหน้า…"
          }
        }
      }
    },
    "Clear Finished": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ล้างรายการที่เสร็จแล้ว"
          }
        }
      }
    },
    "Drop files or folders here": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลากไฟล์หรือโฟลเดอร์มาวางที่นี่"
          }
        }
      }
    },
    "Choose Files…": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกไฟล์…"
          }
        }
      }
    },
    "Merge %lld files into one PDF": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รวม %lld ไฟล์เป็น PDF เดียว"
          }
        }
      }
    },
    "Split %@": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แยก %@"
          }
        }
      }
    },
    "Converted %@": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แปลง %@ แล้ว"
          }
        }
      }
    },
    "Converted %lld files": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แปลง %lld ไฟล์แล้ว"
          }
        }
      }
    },
    "%lld failed": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ล้มเหลว %lld ไฟล์"
          }
        }
      }
    },
    "Converting…": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กำลังแปลง…"
          }
        }
      }
    },
    "Drop on a format": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วางบนรูปแบบที่ต้องการ"
          }
        }
      }
    },
    "Open Tangerine": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิด Tangerine"
          }
        }
      }
    },
    "Show format menu": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แสดงเมนูรูปแบบ"
          }
        }
      }
    },
    "Launch at login": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดแอพเมื่อเข้าสู่ระบบ"
          }
        }
      }
    },
    "Quit Tangerine": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ออกจาก Tangerine"
          }
        }
      }
    },
    "Always when dragging a file": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทุกครั้งที่ลากไฟล์"
          }
        }
      }
    },
    "Only while holding Shift": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เฉพาะตอนกด Shift ค้าง"
          }
        }
      }
    },
    "Only when pressing %@": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เฉพาะตอนกด %@"
          }
        }
      }
    },
    "Text only: layout, images and tables are not kept.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ได้เฉพาะข้อความ: ไม่คงเลย์เอาต์ รูปภาพ และตาราง"
          }
        }
      }
    },
    "Fonts, tables or images may look slightly different.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ฟอนต์ ตาราง หรือรูปภาพอาจดูต่างจากต้นฉบับเล็กน้อย"
          }
        }
      }
    },
    "Animated GIFs keep only the first frame.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "GIF เคลื่อนไหวจะเหลือเฟรมแรกเฟรมเดียว"
          }
        }
      }
    },
    "Can't read %@.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อ่านไฟล์ %@ ไม่ได้"
          }
        }
      }
    },
    "Converting %@ to %@ isn't supported.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่รองรับการแปลง %@ เป็น %@"
          }
        }
      }
    },
    "Couldn't write %@.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เขียนไฟล์ %@ ไม่ได้"
          }
        }
      }
    },
    "%@ is password protected.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ มีรหัสผ่านป้องกันอยู่"
          }
        }
      }
    },
    "%@ has no pages.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ไม่มีหน้า"
          }
        }
      }
    },
    "%@ has no selectable text (it may be a scan).": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ไม่มีข้อความที่เลือกได้ (อาจเป็นไฟล์สแกน)"
          }
        }
      }
    },
    "%lld files · %@": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld ไฟล์ · %@"
          }
        }
      }
    }
  }
}
